# ---------------------------------------------------------------------------
# Super Cake — environment template
# Copy to `.env.local` and fill in your values.
#
# SQL migrations must be run in this order:
#   1. supabase/schema.sql
#   2. supabase/whatsapp-automation.sql
#   3. supabase/phase-fixes.sql
# ---------------------------------------------------------------------------

# Public site URL (no trailing slash), e.g. https://supercake.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random string used to sign session cookies (32+ characters)
AUTH_SECRET=change-me-to-a-long-random-string

# Key used to HMAC-hash phone OTP codes. Falls back to AUTH_SECRET when empty.
# Set a separate 32+ character value in production.
OTP_SECRET=

# Phone OTP flow: the customer sends `VERIFY-XXXXXX` from their own WhatsApp
# number. In development the code is auto-verified and can also be typed.
# Keep this false in production (only set true on a staging demo).
OTP_DEV_AUTO_VERIFY=false

# ---- Local JSON store -----------------------------------------------------
# Development/demo mode uses `.data/db.json` and needs no configuration.
# `next start` sets NODE_ENV=production, which refuses the local store unless
# this is explicitly true. Never enable it on a real deployment.
# ALLOW_LOCAL_STORE=true

# ---- WhatsApp Cloud API (Meta) — optional --------------------------------
# Leave empty to skip automatic messages (wa.me links still work everywhere).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_FROM_NUMBER=
WHATSAPP_WABA_ID=
# Random string used when verifying the Meta webhook
WHATSAPP_VERIFY_TOKEN=
# Meta App Dashboard -> Settings -> Basic -> App Secret (for webhook signatures)
WHATSAPP_APP_SECRET=
# Set to true only after your message templates are APPROVED by Meta
WHATSAPP_TEMPLATES_ENABLED=false
WHATSAPP_TEMPLATE_LANG=bn
# Set to false to pause all automatic WhatsApp sends
WHATSAPP_AUTOMATION_ENABLED=true

# ---- Cron (abandoned cart reminders) --------------------------------------
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ---- Supabase — optional --------------------------------------------------
# Leave empty to run the built-in zero-config demo store (local JSON data).
# Fill in to use production PostgreSQL + Storage. Run schema.sql,
# whatsapp-automation.sql and phase-fixes.sql in the SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
